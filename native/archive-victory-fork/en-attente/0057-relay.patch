+#[cfg(test)]
+fn gated_refresh(alias: bool) {
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEM_RELEASE, MEM_RESERVE, PAGE_READWRITE, VirtualAlloc, VirtualFree,
+    };
+    if std::env::var_os("VICTORY_RELAY_LAZY_PATCH").is_none_or(|v| v != "1")
+        || !cfg!(feature = "diagnostics")
+        || std::env::var_os("VICTORY_D3D12_WARP").is_none()
+    {
+        return;
+    }
+    assert!(
+        available(),
+        "the WARP test requires the relay and its patch pipeline"
+    );
+    let host = host().unwrap();
+    assert!(
+        unsafe { host.adapter.as_ref().unwrap().GetDesc1() }
+            .unwrap()
+            .Flags
+            & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32
+            != 0
+    );
+    const LEN: usize = 2 << 20;
+    const BYTES: usize = 4096;
+    const KEY: usize = 0x507a010;
+    // SAFETY: private write-watched test allocation, alive until both flights land.
+    let title = unsafe {
+        VirtualAlloc(
+            std::ptr::null(),
+            LEN,
+            MEM_COMMIT | MEM_RESERVE | 0x20_0000,
+            PAGE_READWRITE,
+        )
+    }
+    .cast::<u8>();
+    assert!(!title.is_null());
+    unsafe { title.write_bytes(0x11, BYTES) };
+    crate::shadow::register(KEY, title as u64, LEN as u64);
+    let shadow = crate::shadow::find(title as u64, LEN as u64).unwrap();
+    assert!(shadow.carded(), "run with VICTORY_CARD_BUFFERS_MIN_MB=1");
+    let initial = host.new_list().unwrap();
+    shadow.refresh(&initial, title as u64, BYTES as u64);
+    initial.close();
+    host.execute(&[&initial]);
+
+    let producer = host.new_list().unwrap();
+    shadow.gpu_writes(&producer, title as u64, BYTES as u64);
+    let (source, mapped) = host.upload_buffer(BYTES as u64).unwrap();
+    let (out, read) = host.shared_buffer(BYTES as u64).unwrap();
+    let consumer = host.new_list().unwrap();
+    shadow.refresh(&consumer, title as u64, BYTES as u64);
+    let observed = if alias {
+        let other = crate::shadow::exact(title as u64, BYTES as u64).unwrap();
+        other.refresh(&consumer, title as u64, BYTES as u64);
+        other
+    } else {
+        shadow.clone()
+    };
+    unsafe {
+        for at in 0..BYTES {
+            mapped
+                .add(at)
+                .write(if alias && at % 2 == 0 { 0x11 } else { 0x76 });
+        }
+        producer
+            .list
+            .CopyBufferRegion(&shadow.buffer, 0, &source, 0, BYTES as u64);
+        consumer
+            .list
+            .CopyBufferRegion(&out, 0, &observed.buffer, 0, BYTES as u64);
+    }
+    producer.close();
+    consumer.close();
+    let gate: ID3D12Fence = unsafe { host.device.CreateFence(0, D3D12_FENCE_FLAG_NONE) }.unwrap();
+    unsafe { host.queue.Wait(&gate, 1) }.unwrap();
+    let (release, rx) = std::sync::mpsc::channel();
+    let guarded = STATS[2].load(Ordering::Relaxed);
+    let watchdog = std::thread::spawn(move || {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(15);
+        let submitted = loop {
+            if alias && STATS[2].load(Ordering::Relaxed) > guarded {
+                break false;
+            }
+            match rx.recv_timeout(std::time::Duration::from_millis(5)) {
+                Ok(()) => break true,
+                Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => break false,
+                Err(_) if std::time::Instant::now() >= deadline => break false,
+                Err(_) => {}
+            }
+        };
+        unsafe { gate.Signal(1) }.unwrap();
+        submitted
+    });
+    host.execute_late(vec![crate::list::Detached::for_test(producer)], vec![0]);
+    for i in (0..BYTES).step_by(2) {
+        unsafe { title.add(i).write_volatile(0xc3) };
+    }
+    let words = STATS[1].load(Ordering::Relaxed);
+    host.execute_late(vec![crate::list::Detached::for_test(consumer)], vec![0]);
+    let _ = release.send(());
+    let ahead = watchdog.join().unwrap();
+    settle_now(WHY_SYNC);
+    let sent = STATS[1].load(Ordering::Relaxed) - words;
+    assert_eq!(ahead, !alias);
+    assert_eq!(STATS[2].load(Ordering::Relaxed) - guarded, u64::from(alias));
+    assert_eq!(sent, if alias { 0 } else { (BYTES / 4) as u64 });
+    eprintln!("alias {alias}, submitted before gate release {ahead}, masked dwords {sent}");
+    for i in 0..BYTES {
+        let expected = if i % 2 == 0 { 0xc3 } else { 0x76 };
+        assert_eq!(
+            unsafe { read.add(i).read_volatile() },
+            expected,
+            "consumer byte {i}"
+        );
+        assert_eq!(
+            unsafe { title.add(i).read_volatile() },
+            expected,
+            "landed byte {i}"
+        );
+    }
+    crate::shadow::unregister(KEY, title as u64);
+    unsafe { VirtualFree(title.cast(), 0, MEM_RELEASE) };
+}
