+/// Hold an earlier GPU write behind a fence. The consumer must return
+/// while it is held and later see both writers' bytes in the same word.
+#[cfg(test)]
+#[test]
+fn warp_fragmented_refresh_submits_before_the_producer_lands() {
+    gated_refresh(false);
+    gated_refresh(true);
+}
