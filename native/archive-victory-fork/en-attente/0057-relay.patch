+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn alias_shadows_cpu_reads_and_pending_publications_require_a_landing() {
+        let writes = HashMap::from([
+            (1, vec![(20, 30), (60, 80)]),
+            (2, vec![(26, 32)]),
+            (0, vec![(10, 20)]),
+        ]);
+        assert!(compatible(&writes, Some(1), 20, 26));
+        assert!(!compatible(&writes, Some(1), 25, 27));
+        assert!(!compatible(&writes, Some(3), 24, 26));
+        assert!(!compatible(&writes, None, 24, 26));
+        assert!(!compatible(&writes, Some(1), 19, 21));
+        assert!(compatible(&writes, None, 32, 60));
+    }
+
+    #[test]
+    fn admitted_pages_are_bounded_across_copies_and_unaligned_spans() {
+        let mut pages = Pages::default();
+        assert!(pages.is_empty());
+        assert!(pages.admit(1, 4095, 4097));
+        for i in 0..126 {
+            assert!(pages.admit(2, i * 4096, (i + 1) * 4096));
+        }
+        assert!(!pages.admit(3, 0, 1));
+        assert!(pages.admit(1, 4095, 4097));
+        assert!(!pages.admit(1, 8191, 8193));
+        assert_eq!(pages.count, 128);
+    }
+
+    #[test]
+    fn packed_and_ordinary_writes_preserve_every_gpu_owned_byte() {
+        let side: Vec<_> = (0..12291).map(|i| (i * 13) as u8).collect();
+        let mut ranges: Vec<_> = (0..3800).step_by(2).map(|a| (a, a + 1)).collect();
+        ranges.extend([
+            (3801, 3805),
+            (4000, 4200),
+            (4600, 4900),
+            (9000, 9001),
+            (12289, 12291),
+        ]);
+        let selected = HashSet::from([0, 1, 3]);
+        let packed = pack(&ranges, &selected, &side);
+        assert_eq!(packed.ordinary, [(4000, 4200), (4600, 4900), (9000, 9001)]);
+        assert_eq!(packed.rehash, [(0, 3805), (12289, 12291)]);
+        assert!(packed.words.windows(2).all(|w| w[0][0] < w[1][0]));
+        let mut gpu = vec![0xab; 12292];
+        let mut expected = gpu.clone();
+        for &(a, b) in &ranges {
+            expected[a..b].copy_from_slice(&side[a..b]);
+        }
+        for (a, b) in packed.ordinary {
+            gpu[a..b].copy_from_slice(&side[a..b]);
+        }
+        for [offset, mask, value] in packed.words {
+            let at = offset as usize;
+            let word = u32::from_le_bytes(gpu[at..at + 4].try_into().unwrap());
+            gpu[at..at + 4].copy_from_slice(&((word & !mask) | value).to_le_bytes());
+        }
+        assert_eq!(gpu, expected);
+        assert_eq!(pack(&ranges, &HashSet::new(), &side).ordinary, ranges);
+    }
+}
