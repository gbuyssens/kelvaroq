index 0000000..41db93f
--- /dev/null
+++ b/crates/victory-gpu/src/host/relay_patch.rs
@@ -0,0 +1,542 @@
+//! The heavy frames spent about 15 ms waiting for copy-back when CPU edits
+//! exceeded the per-submission copy limit. A masked store can apply those
+//! edits after the older GPU writes while their copy-back is still pending.
+//! Approach after XCL 49a2546: preserve neighboring GPU bytes when publishing CPU writes to mirrored memory.
+
+use super::*;
+use crate::shadow::Shadow;
+use std::collections::{HashMap, HashSet};
+use std::sync::Arc;
+
+pub(crate) fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_RELAY_LAZY_PATCH").is_some_and(|v| v == "1"))
+        && relay()
+        && late_exact()
+}
+
+/// Bound the extra CPU work before falling back to a settle. A title page
+/// can straddle two pages of an unaligned shadow.
+#[derive(Default)]
+pub(crate) struct Pages {
+    writers: Vec<Arc<Writers>>,
+    by_copy: HashMap<usize, HashSet<usize>>,
+    count: usize,
+    readers_checked: bool,
+    check_readers: bool,
+}
+
+impl Pages {
+    /// A flight can land after the write-watch query but before a fragmented
+    /// page is found. Its write still has to be considered for that query.
+    pub(super) fn at_watch(behind: bool) -> Self {
+        let mut pages = Self::default();
+        if behind && enabled() {
+            pages
+                .writers
+                .extend(line().patch_writers.iter().map(|(_, w)| Arc::clone(w)));
+        }
+        pages
+    }
+
+    pub(crate) fn request_check(&mut self) -> bool {
+        self.check_readers = !self.readers_checked;
+        self.check_readers
+    }
+
+    pub(super) fn check(&mut self, runs: &[&HostList], gpu_fills: &HashSet<usize>) -> bool {
+        if !std::mem::take(&mut self.check_readers) {
+            return false;
+        }
+        self.readers_checked = can_defer(&self.writers, runs, gpu_fills);
+        if !self.readers_checked {
+            STATS[2].fetch_add(1, Ordering::Relaxed);
+        }
+        self.readers_checked
+    }
+
+    pub(super) fn is_empty(&self) -> bool {
+        self.count == 0
+    }
+
+    pub(crate) fn admit(&mut self, copy: usize, from: usize, end: usize) -> bool {
+        let pages = self.by_copy.entry(copy).or_default();
+        let covered = from / 4096..=(end - 1) / 4096;
+        let new = covered.clone().filter(|p| !pages.contains(p)).count();
+        if self.count + new > 128 {
+            return false;
+        }
+        pages.extend(covered);
+        self.count += new;
+        true
+    }
+}
+
+// One thread owns each affected dword. Reading it on the direct queue
+// preserves the GPU's latest value in every unselected byte.
+const APPLY: &str = r#"
+cbuffer Bounds : register(b0) { uint count; };
+ByteAddressBuffer edits : register(t0);
+RWByteAddressBuffer destination : register(u0);
+[RootSignature("RootConstants(num32BitConstants=1,b0), SRV(t0), UAV(u0)")]
+[numthreads(64,1,1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    if (id.x >= count) return;
+    uint3 edit = edits.Load3(id.x * 12);
+    destination.Store(edit.x, (destination.Load(edit.x) & ~edit.y) | edit.z);
+}
+"#;
+
+type Pipeline = (ID3D12RootSignature, ID3D12PipelineState);
+
+fn pipeline(host: &Host) -> Option<&'static Pipeline> {
+    static STATE: OnceLock<Option<Pipeline>> = OnceLock::new();
+    STATE
+        .get_or_init(|| {
+            let code = compile(
+                APPLY,
+                windows::core::s!("main"),
+                windows::core::s!("cs_5_1"),
+            )
+            .ok()?;
+            // SAFETY: the root signature is embedded in this shader.
+            unsafe {
+                let root = host.device.CreateRootSignature(0, &code).ok()?;
+                let pso = host
+                    .device
+                    .CreateComputePipelineState(&D3D12_COMPUTE_PIPELINE_STATE_DESC {
+                        pRootSignature: std::mem::transmute_copy(&root),
+                        CS: D3D12_SHADER_BYTECODE {
+                            pShaderBytecode: code.as_ptr().cast(),
+                            BytecodeLength: code.len(),
+                        },
+                        ..Default::default()
+                    })
+                    .ok()?;
+                Some((root, pso))
+            }
+        })
+        .as_ref()
+}
+
+pub(crate) fn available() -> bool {
+    enabled() && host().and_then(pipeline).is_some()
+}
+
+type Range = (usize, usize);
+
+/// A CPU copy, texture upload or different shadow may consume an older
+/// write through title memory. The run cap used to settle these producers
+/// too. Check their destinations before replacing that settle with a patch.
+fn can_defer(flights: &[Arc<Writers>], runs: &[&HostList], gpu_fills: &HashSet<usize>) -> bool {
+    let mut writes = Writers::new();
+    for flight in flights {
+        for (&owner, ranges) in flight.iter() {
+            writes.entry(owner).or_default().extend(ranges);
+        }
+    }
+    let Some(_mapping) = crate::watch::title_memory_reading_now() else {
+        return false;
+    };
+    for ranges in writes.values_mut() {
+        join_ranges(ranges, []);
+    }
+    // Different virtual addresses can map the same physical pages. If a
+    // producer is mapped, only a private consumer proves disjoint storage.
+    let mapped_writer = writes
+        .values()
+        .flatten()
+        .any(|&(a, b)| !crate::inplace::private_whole(a, b - a));
+    let safe = |owner, address: usize, bytes: usize| {
+        bytes == 0
+            || (address
+                .checked_add(bytes)
+                .is_some_and(|end| compatible(&writes, owner, address, end))
+                && (!mapped_writer || crate::inplace::private_whole(address, bytes)))
+    };
+    // Refresh work joins this shadow's ranges into an envelope. A write in
+    // a gap can therefore be read even if neither recorded view includes it.
+    let mut refreshes: HashMap<usize, Range> = HashMap::new();
+    for list in runs {
+        for step in &list.deferred().copies {
+            let proven = match step {
+                Step::Refresh(shadow, at, n) | Step::GpuWrite(shadow, at, n) => {
+                    if *n == 0 {
+                        continue;
+                    }
+                    let Some(end) = at.checked_add(*n) else {
+                        return false;
+                    };
+                    let span = refreshes
+                        .entry(Arc::as_ptr(shadow) as usize)
+                        .or_insert((*at, end));
+                    span.0 = span.0.min(*at);
+                    span.1 = span.1.max(end);
+                    true
+                }
+                Step::Copy(to, from, n) => safe(None, *from, *n) && safe(None, *to, *n),
+                Step::Fill(dst, from, n, _) => gpu_fills.contains(dst) || safe(None, *from, *n),
+                Step::Texture(staging) => {
+                    let (from, n) = staging.memory();
+                    safe(None, from, n)
+                }
+                Step::Host(_) | Step::Run(_) => false,
+            };
+            if !proven {
+                return false;
+            }
+        }
+    }
+    refreshes
+        .into_iter()
+        .all(|(owner, (a, b))| safe(Some(owner), a, b - a))
+}
+
+pub(super) type Writers = HashMap<usize, Vec<(usize, usize)>>;
+
+/// Keep the destinations until every item in the landing is published.
+/// A row-pitched readback covers its first byte through its last row.
+pub(super) fn remember(flights: &mut Vec<(u64, Arc<Writers>)>, number: u64, items: &[Late]) {
+    if !enabled() {
+        return;
+    }
+    let mut writes = Writers::new();
+    for item in items {
+        match item {
+            Late::Run(flight) => {
+                for (shadow, ranges) in &flight.back {
+                    writes
+                        .entry(Arc::as_ptr(shadow) as usize)
+                        .or_default()
+                        .extend(ranges);
+                }
+                for &index in &flight.order {
+                    for (_, at, [row, rows, pitch]) in &flight.lists[index].host().deferred().backs
+                    {
+                        if *rows > 0 && *row > 0 {
+                            let bytes = (rows - 1).saturating_mul(*pitch).saturating_add(*row);
+                            writes
+                                .entry(0)
+                                .or_default()
+                                .push((*at, at.saturating_add(bytes)));
+                        }
+                    }
+                }
+            }
+            Late::Write(at, _, len) => writes
+                .entry(0)
+                .or_default()
+                .push((*at, at.saturating_add(*len))),
+            Late::Signal(..) => {}
+        }
+    }
+    if !writes.is_empty() {
+        flights.push((number, Arc::new(writes)));
+    }
+}
+
+fn compatible(
+    writes: &HashMap<usize, Vec<Range>>,
+    reader: Option<usize>,
+    from: usize,
+    end: usize,
+) -> bool {
+    writes
+        .iter()
+        .all(|(&owner, ranges)| Some(owner) == reader || !touches(ranges, from, end))
+}
+
+#[derive(Default)]
+struct Packed {
+    ordinary: Vec<Range>,
+    words: Vec<[u32; 3]>,
+    rehash: Vec<Range>,
+}
+
+/// The dirty ranges are disjoint and sorted. Only short ranges on admitted
+/// pages are packed. Large transfers still take the ordinary copy lane.
+fn pack(ranges: &[Range], selected: &HashSet<usize>, side: &[u8]) -> Packed {
+    let mut packed = Packed::default();
+    for &(from, end) in ranges {
+        let page = from / 4096;
+        if !selected.contains(&page) || (end - 1) / 4096 != page || end - from > 256 {
+            packed.ordinary.push((from, end));
+            continue;
+        }
+        match packed.rehash.last_mut() {
+            Some((a, b)) if *a / 4096 == page => *b = end,
+            _ => packed.rehash.push((from, end)),
+        }
+        for (offset, &byte) in side[from..end].iter().enumerate() {
+            let at = (from + offset) as u32;
+            let word = at & !3;
+            if packed.words.last().is_none_or(|w| w[0] != word) {
+                packed.words.push([word, 0, 0]);
+            }
+            let entry = packed.words.last_mut().unwrap();
+            let shift = (at & 3) * 8;
+            entry[1] |= 255 << shift;
+            entry[2] |= u32::from(byte) << shift;
+        }
+    }
+    packed
+}
+
+pub(super) struct Patch {
+    input: ID3D12Resource,
+    words: u32,
+    pub(super) rehash: Vec<Range>,
+    pipeline: &'static Pipeline,
+}
+
+impl Patch {
+    pub(super) fn prepare(
+        host: &Host,
+        shadow: &Arc<Shadow>,
+        ranges: &mut Vec<Range>,
+        pages: &Pages,
+    ) -> Option<Self> {
+        let selected = pages.by_copy.get(&(Arc::as_ptr(shadow) as usize))?;
+        let pipeline = pipeline(host)?;
+        let packed = shadow.with_card_bytes(|side| pack(ranges, selected, side));
+        let words = packed.words.len() as u32;
+        if words == 0 {
+            return None;
+        }
+        let bytes = u64::from(words) * 12;
+        let (input, mapping) = host.upload_buffer(bytes)?;
+        // SAFETY: the allocation holds the entire immutable dispatch input.
+        unsafe {
+            std::ptr::copy_nonoverlapping(
+                packed.words.as_ptr().cast::<u8>(),
+                mapping,
+                bytes as usize,
+            )
+        };
+        // Keep every ordinary copy if allocation failed above.
+        *ranges = packed.ordinary;
+        STATS[1].fetch_add(u64::from(words), Ordering::Relaxed);
+        Some(Self {
+            input,
+            words,
+            rehash: packed.rehash,
+            pipeline,
+        })
+    }
+
+    pub(super) fn record(&self, list: &ID3D12GraphicsCommandList, target: &ID3D12Resource) {
+        // SAFETY: one entry per dword of this UAV, at most 128 pages.
+        // The submission owns the upload buffer through fence completion.
+        unsafe {
+            list.SetComputeRootSignature(&self.pipeline.0);
+            list.SetPipelineState(&self.pipeline.1);
+            list.SetComputeRoot32BitConstant(0, self.words, 0);
+            list.SetComputeRootShaderResourceView(1, self.input.GetGPUVirtualAddress());
+            list.SetComputeRootUnorderedAccessView(2, target.GetGPUVirtualAddress());
+            list.Dispatch(self.words.div_ceil(64), 1, 1);
+        }
+    }
+}
