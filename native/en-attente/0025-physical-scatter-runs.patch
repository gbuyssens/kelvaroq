+/// Applique le préfixe contigu ou rend zéro pour reprendre page par page.
+/// Les remplacements de vues existantes gardent leur ordre, y compris
+/// l’effet sur la destination d’une page inconnue ou d’un échec Windows.
+fn scatter_run(addresses: *const *mut c_void, remaining: usize, pages: *const usize) -> usize {
+    // SAFETY: le contrat de Scatter fournit remaining adresses et, si le
+    // pointeur est présent, autant de numéros de pages.
+    let address = |i| unsafe { *addresses.add(i) as usize };
+    let page = |i| if pages.is_null() { 0 } else { unsafe { *pages.add(i) } };
+    let base = address(0);
+    if base == 0 || !base.is_multiple_of(PAGE) || base.checked_add(PAGE) != Some(address(1)) {
+        return 0;
+    }
+    let mut physical = physical();
+    let first = match page(0) {
+        0 => None,
+        number => match physical.pages.get(&number) {
+            Some(s) if shown(&physical, base).is_none() => Some(s.clone()),
+            _ => return 0,
+        },
+    };
+    let mut run = 1;
+    // Limite le parcours anticipé et l’attente des autres lecteurs.
+    while run < remaining.min(64) && base.checked_add(run * PAGE) == Some(address(run)) {
+        let number = page(run);
+        let follows = match &first {
+            None => number == 0,
+            Some(s) => physical.pages.get(&number).is_some_and(|next| {
+                Arc::ptr_eq(&next.section, &s.section) && s.index.checked_add(run) == Some(next.index)
+            }),
+        };
+        if !follows {
+            break;
+        }
+        run += 1;
+    }
+    if run < 2 {
+        return 0;
+    }
+    let bytes = run * PAGE;
+    let Some(end) = base.checked_add(bytes) else { return 0 };
+    // Si les tableaux d’entrée sont eux-mêmes dans la destination, leurs
+    // entrées doivent être lues une par une, comme dans le chemin du fork.
+    let overlaps_input = |at: usize| at < end && at.saturating_add(remaining.saturating_mul(size_of::<usize>())) > base;
+    if overlaps_input(addresses as usize) || (!pages.is_null() && overlaps_input(pages as usize)) {
+        return 0;
+    }
+    if first.is_some() && physical.views.range(base..end).next().is_some() {
+        return 0;
+    }
+    let _changing = victory_gpu::title_memory_remapping();
+    if let Some(slice) = first {
+        if !map(&mut physical, base, bytes, slice) {
+            return 0;
+        }
+    } else {
+        // Un seul retrait évite de recréer le reste d’une grande vue
+        // à chaque page enlevée. Les vues extérieures sont préservées.
+        unmap(&mut physical, base, bytes);
+    }
+    run
