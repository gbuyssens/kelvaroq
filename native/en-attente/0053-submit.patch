+    let mut work = Vec::with_capacity(64);
+    let allocation = work.as_ptr();
+    for size in [0, 1, 3, 45] {
+        work.extend(1..=size);
+        assert_eq!(grouped_refresh(&mut work, 3, |n| *n), size * (size + 1) / 2);
+        assert!(work.is_empty());
+        assert_eq!(work.as_ptr(), allocation);
+    }
+}
