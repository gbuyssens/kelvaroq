+            INVALID_HANDLE_VALUE,
+            std::ptr::null(),
+            mem::PAGE_READWRITE | mem::SEC_COMMIT,
+            0,
+            2 * size as u32,
+            std::ptr::null(),
+        );
+        assert!(!section.is_null());
+        crate::title_memory_section(section as usize, 2 * PAGE, true);
+        let show = |offset, word: u32| {
+            let view = mem::MapViewOfFile3(
+                section,
+                process,
+                base,
