+        let list = host.new_list().unwrap();
+        let heap = HostHeap::new(false, 32).unwrap();
+        let ready = super::super::ready(&list, &heap, &[addr], &[], false).unwrap();
+        let (out, data) = host.shared_buffer(256).unwrap();
+        let step = host
+            .device
