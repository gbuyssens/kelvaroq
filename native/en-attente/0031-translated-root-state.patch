+        let words = unsafe { std::slice::from_raw_parts(mem.cast::<u32>(), 18) };
+        let mut expected = [0u32; 18];
+        expected[0] = 14;
+        expected[1] = 9;
+        expected[17] = 3;
+        assert_eq!(words, expected);
+        eprintln!("direct/indirect root-binding readback: {}, {}, {}", words[0], words[1], words[17]);
