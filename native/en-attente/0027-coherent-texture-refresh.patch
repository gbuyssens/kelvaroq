+impl Last {
+    /// On contention, keep an already populated staging image once. A first
+    /// upload or a second miss waits for a complete mapping generation.
+    fn defer_remap(&mut self) -> bool {
+        if !self.published || self.deferred {
+            return false;
+        }
+        self.deferred = true;
+        self.asked = 0;
+        true
+    }
 }
 
