1 VERSIONINFO
FILEVERSION @NUMS@
PRODUCTVERSION @NUMS@
FILEOS 0x40004L
FILETYPE 1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Velkin contributors\0"
   VALUE "ProductName", "Velkin\0"
   VALUE "FileDescription", "Velkin\0"
   VALUE "FileVersion", "@VERSION@\0"
   VALUE "ProductVersion", "@VERSION@\0"
   VALUE "OriginalFilename", "Velkin.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
